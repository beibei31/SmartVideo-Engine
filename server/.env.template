# SmartVideo-Engine environment template
# Copy this file to .env and fill your own credentials.
# Never commit the real .env file.

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

ALIYUN_API_KEY=replace-with-your-aliyun-key

# Public URL used by Aliyun ASR to fetch audio from MinIO.
# For local demo, expose MinIO with ngrok and replace this value.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
